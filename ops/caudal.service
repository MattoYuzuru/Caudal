[Unit]
Description=Caudal fleet control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=caudal
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/caudal/control.env
LoadCredential=owner-password:/etc/caudal/owner-password
LoadCredential=mcp-token:/etc/caudal/mcp-token
Environment=CAUDAL_OWNER_PASSWORD_FILE=%d/owner-password
Environment=CAUDAL_MCP_TOKEN_FILE=%d/mcp-token
Environment=CAUDAL_DATA_DIR=/var/lib/caudal/fleet
Environment=CAUDAL_WEB_DIR=/opt/caudal/current/web
Environment=CAUDAL_DOWNLOAD_DIR=/opt/caudal/current/downloads
ExecStart=/opt/caudal/current/caudal
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=96M
MemoryMax=160M
TasksMax=32

[Install]
WantedBy=multi-user.target
